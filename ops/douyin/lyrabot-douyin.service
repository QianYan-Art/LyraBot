[Unit]
Description=LyraBot Douyin creator service
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
User=douyin-runner
Group=lyrabot-douyin
WorkingDirectory=/opt/lyrabot-douyin
Environment=DOUYIN_DATA_DIR=/var/lib/lyrabot-douyin
Environment=DOUYIN_SOCKET_PATH=/run/lyrabot-douyin/login.sock
EnvironmentFile=/etc/lyrabot-douyin.env
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x900x24 -nolisten tcp" /opt/lyrabot-douyin/venv/bin/python /opt/lyrabot-douyin/service.py
ExecStop=/opt/lyrabot-douyin/venv/bin/python /opt/lyrabot-douyin/service.py --stop $MAINPID
RuntimeDirectory=lyrabot-douyin
RuntimeDirectoryMode=0750
StateDirectory=lyrabot-douyin
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
TimeoutStartSec=20
KillMode=mixed
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/lyrabot-douyin /run/lyrabot-douyin

[Install]
WantedBy=multi-user.target
