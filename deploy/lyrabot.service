[Unit]
Description=LyraBot personal agent
After=network-online.target lyrabot-douyin.service
Wants=network-online.target

[Service]
# notify：进入服务循环时报 READY=1；看门狗心跳只在 QQ 接收循环仍在推进、存储线程能响应时发出，
# 卡死超过 WatchdogSec 由 systemd 杀掉并按 Restart=always 拉起
Type=notify
NotifyAccess=main
WatchdogSec=60
User=lyrabot
Group=lyrabot
WorkingDirectory=/var/lib/lyrabot
Environment=LYRABOT_LOG=warn,lyrabot=info
ExecStart=/opt/lyrabot/bin/lyrabot --config /etc/lyrabot/lyrabot.toml --qq
Restart=always
RestartSec=5
# 常驻内存目标 ≤40 MB，这里只是失控保护
MemoryMax=400M
TimeoutStopSec=20
KillMode=mixed

[Install]
WantedBy=multi-user.target
