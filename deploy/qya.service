[Unit]
Description=qy-assistant (唐语歌) personal agent
After=network-online.target tangyuge-douyin.service
Wants=network-online.target

[Service]
Type=simple
User=tangyuge
Group=tangyuge
WorkingDirectory=/var/lib/qya
Environment=QYA_LOG=warn,qya=info
ExecStart=/opt/qya/bin/qya --config /etc/qya/qya.toml --qq
Restart=always
RestartSec=5
# 常驻内存目标 ≤40 MB，这里只是失控保护
MemoryMax=400M
TimeoutStopSec=20
KillMode=mixed

[Install]
WantedBy=multi-user.target
